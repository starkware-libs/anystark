#[test]
#[should_panic(expected: 'NOT_IN_MIGRATION')]
fn outside_execution_rejects_direct_migration_hook_call() {
    // SNIP-9 forbidden-call closure (the gap Fix 1 closes): an owner-signed outside-
    // execution bundle whose only call is the account's own execute_after_upgrade is
    // REJECTED. Every guard before execution passes - caller (ANY_CALLER), window, nonce,
    // and the Ed25519 signature all validate - so OZ's SRC9 reaches execute_calls and runs
    // the hook via a raw call_contract_syscall, which bypasses __execute__'s FORBIDDEN_CALL
    // guard and presents caller == the account == self. The hook's caller check is thus
    // satisfied; only the path-independent migration_in_progress flag (false outside an
    // upgrade) stops it, reverting NOT_IN_MIGRATION. Reaching that named error (not
    // MSG_NOT_BOUND) also proves the signature bound, i.e. the call really executed.
    let account = deploy_account_at(VECTOR_ACCOUNT);
    start_cheat_block_timestamp(account, IN_WINDOW_TS);
    ISRC9_V2Dispatcher { contract_address: account }
        .execute_from_outside_v2(migration_hook_request(), migration_hook_signature().span());
}

#[test]
fn outside_execution_executes_calls() {
    let account = deploy_account_at(VECTOR_ACCOUNT);
    let mock = deploy_mock_target();
    start_cheat_block_timestamp(account, IN_WINDOW_TS);

    // Anyone may submit (the vector pins the ANY_CALLER sentinel), so the test's
    // default caller plays the relayer — no caller cheat needed.
    let results = ISRC9_V2Dispatcher { contract_address: account }
        .execute_from_outside_v2(vector_request(VECTOR_CALLDATA), vector_signature().span());

    // One retdata span per executed call, and transfer returns unit so that span
    // is empty — pins the full shape of execute_from_outside_v2's output.
    assert!(results.len() == 1);
    assert!((*results.at(0)).len() == 0);
    // ...and the target really ran with the signed payload, called BY the account:
    // to the target, outside execution is indistinguishable from self-execution
    // (the relayer never appears in the call chain it observes).
    let (observed_caller, observed_value) = mock.last_call();
    assert!(observed_caller == account);
    assert!(observed_value == VECTOR_CALLDATA);
}

#[test]
fn outside_execution_accepts_pinned_caller() {
    // The caller-guard ACCEPTANCE branch: when the signed caller is a specific
    // address (not ANY_CALLER), only that submitter may run it. Cheat the caller to
    // the pinned PINNED_CALLER and the request executes — the mirror of
    // outside_execution_rejects_wrong_caller (test_sol_account.cairo), which pins
    // the rejection branch.
    let account = deploy_account_at(VECTOR_ACCOUNT);
    let mock = deploy_mock_target();
    start_cheat_block_timestamp(account, IN_WINDOW_TS);
    cheat_caller_address(account, PINNED_CALLER.try_into().unwrap(), CheatSpan::TargetCalls(1));

    let results = ISRC9_V2Dispatcher { contract_address: account }
        .execute_from_outside_v2(pinned_caller_request(), pinned_caller_signature().span());

    assert!(results.len() == 1);
    let (observed_caller, observed_value) = mock.last_call();
    assert!(observed_caller == account);
    assert!(observed_value == VECTOR_CALLDATA);
}

#[test]
fn outside_execution_consumes_nonce() {
    // SRC9 nonces are user-chosen felts in a per-account map — independent of the
    // protocol nonce and NOT sequential. is_valid_outside_execution_nonce is the
    // view a relayer polls; executing the request flips exactly the signed nonce.
    let account = deploy_account_at(VECTOR_ACCOUNT);
    deploy_mock_target();
    start_cheat_block_timestamp(account, IN_WINDOW_TS);
    let src9 = ISRC9_V2Dispatcher { contract_address: account };

    assert!(src9.is_valid_outside_execution_nonce(VECTOR_NONCE));
    src9.execute_from_outside_v2(vector_request(VECTOR_CALLDATA), vector_signature().span());
    assert!(!src9.is_valid_outside_execution_nonce(VECTOR_NONCE));
}

#[test]
#[should_panic(expected: 'SRC9: duplicated nonce')]
fn outside_execution_rejects_replayed_nonce() {
    // Replay protection: resubmitting the byte-identical request dies on the
    // consumed nonce (checked after caller/window, before the signature is ever
    // re-verified) — a relayer cannot run the same signed request twice.
    let account = deploy_account_at(VECTOR_ACCOUNT);
    deploy_mock_target();
    start_cheat_block_timestamp(account, IN_WINDOW_TS);
    let src9 = ISRC9_V2Dispatcher { contract_address: account };

    src9.execute_from_outside_v2(vector_request(VECTOR_CALLDATA), vector_signature().span());
    src9.execute_from_outside_v2(vector_request(VECTOR_CALLDATA), vector_signature().span());
}

#[test]
#[feature("safe_dispatcher")]
fn failed_execution_does_not_consume_nonce() {
    // OZ writes the nonce BEFORE validating the signature (src9.cairo), so only the
    // transaction revert un-burns it. A relayer submitting a tampered request must
    // NOT dead-lock the user's still-signable nonce — after the failed attempt the
    // view must still report the nonce as unused. Uses a SafeDispatcher so the
    // 'SRC9: invalid signature' panic surfaces as Err instead of aborting the test.
    let account = deploy_account_at(VECTOR_ACCOUNT);
    start_cheat_block_timestamp(account, IN_WINDOW_TS);
    let src9 = ISRC9_V2Dispatcher { contract_address: account };
    assert!(src9.is_valid_outside_execution_nonce(VECTOR_NONCE));

    let safe = ISRC9_V2SafeDispatcher { contract_address: account };
    // 0xcaff != the signed 0xcafe, so message binding fails before any call runs. The
    // is_valid_signature self-call returns 0 (SNIP-6 conformance), and OZ's SRC9 turns
    // that into 'SRC9: invalid signature', so the outer tx still reverts.
    let result = safe.execute_from_outside_v2(vector_request(0xcaff), vector_signature().span());
    assert!(result.is_err());

    assert!(src9.is_valid_outside_execution_nonce(VECTOR_NONCE));
}

#[test]
#[should_panic(expected: 'SRC9: invalid signature')]
fn outside_execution_rejects_tampered_calls() {
    // A relayer cannot alter WHAT executes: same signature, but the request carries
    // calldata 0xcaff instead of the signed 0xcafe. The SNIP-12 hash the account
    // computes changes, the signed text encodes the old hash, not the new one, and
    // message binding fails before any call executes and before the Ed25519 verification
    // is reached. The is_valid_signature self-call returns 0 (SNIP-6 conformance: our inner
    // 'MSG_NOT_BOUND' reason is not a revert), and OZ's SRC9 surfaces that as its generic
    // 'SRC9: invalid signature'.
    let account = deploy_account_at(VECTOR_ACCOUNT);
    start_cheat_block_timestamp(account, IN_WINDOW_TS);
    ISRC9_V2Dispatcher { contract_address: account }
        .execute_from_outside_v2(vector_request(0xcaff), vector_signature().span());
}

#[test]
#[should_panic(expected: 'SRC9: invalid signature')]
fn outside_execution_rejects_other_account() {
    // Cross-account replay is dead: a second SolAccount holding the SAME key but
    // deployed at a DIFFERENT address rejects the untouched vector, because the
    // SNIP-12 hash folds in the account address — this account computes a hash the
    // signed text does not encode. Same failure shape as tampering: the signer
    // still matches, so it is the message binding that kills it. is_valid_signature
    // returns 0 for that inner 'MSG_NOT_BOUND' reason (SNIP-6 conformance), and OZ's
    // SRC9 surfaces it as the generic 'SRC9: invalid signature'.
    let other = deploy_account_at(OTHER_ACCOUNT);
    start_cheat_block_timestamp(other, IN_WINDOW_TS);
    ISRC9_V2Dispatcher { contract_address: other }
        .execute_from_outside_v2(vector_request(VECTOR_CALLDATA), vector_signature().span());
}

// Deploys SolAccount (PK1) pinned at `address`: the vector is only valid at the
// exact address its SNIP-12 hash was bound to, so tests choose where accounts live.
fn deploy_account_at(address: felt252) -> ContractAddress {
    let cls = declare("SolAccount").unwrap().contract_class();
    let account: ContractAddress = address.try_into().unwrap();
    cls.deploy_at(@array![PK1.low.into(), PK1.high.into()], account).unwrap();
    account
}

// Deploys the recording mock at the vector's call target. The happy path executes
// the signed call for real, so something callable must live at that address.
fn deploy_mock_target() -> ICallReceiverDispatcher {
    let cls = declare("CallReceiverMock").unwrap().contract_class();
    let target: ContractAddress = VECTOR_TARGET.try_into().unwrap();
    cls.deploy_at(@array![], target).unwrap();
    ICallReceiverDispatcher { contract_address: target }
}

// SNIP-12 domain metadata, copied VERBATIM from openzeppelin_account 3.0.0
// src9.cairo (name shortstring + version felt) so this test computes the SAME hash
// the embedded SRC9Component computes on-chain.
impl VectorSNIP12Metadata of SNIP12Metadata {
    fn name() -> felt252 {
        'Account.execute_from_outside'
    }
    fn version() -> felt252 {
        2
    }
}

// Re-derivation aid — the documented one-liner for regenerating the vector.
// `snforge test --ignored print_vector_snip12_hash` panics with OZ's Cairo
// get_message_hash for the fixture tuple, which is the `expectedHash=` the
// generator (gen_snip9_vector.mjs) needs to cross-check any new tuple. Ignored so
// it never runs in the normal suite (a passing test cannot print a panic message).
#[test]
#[ignore]
fn print_vector_snip12_hash() {
    let account: ContractAddress = VECTOR_ACCOUNT.try_into().unwrap();
    let hash = vector_request(VECTOR_CALLDATA).get_message_hash(account);
    panic!("VECTOR_SNIP12_HASH={}", hash);
}
