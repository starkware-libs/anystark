// SNIP-9 outside execution, driven by ONE locked real-crypto vector: a full
// OutsideExecution request signed by the repo's locked Ed25519 test key and
// encoded with @starkware-libs/anystark-core's production felt encoder. The component's guard-order
// tests (caller / window / reaching validation) live in test_sol_account.cairo;
// this file proves the happy path actually EXECUTES the signed call, and that
// the request can be neither altered, replayed, nor moved to another account.
use openzeppelin_account::extensions::src9::snip12_utils::OutsideExecutionStructHash;
use openzeppelin_interfaces::src9::{
    ISRC9_V2Dispatcher, ISRC9_V2DispatcherTrait, ISRC9_V2SafeDispatcher,
    ISRC9_V2SafeDispatcherTrait, OutsideExecution,
};
use openzeppelin_utils::cryptography::snip12::{OffchainMessageHash, SNIP12Metadata};
use snforge_std::{
    CheatSpan, ContractClassTrait, DeclareResultTrait, cheat_caller_address, declare,
    start_cheat_block_timestamp,
};
use starknet::ContractAddress;
use starknet::account::Call;
use crate::test_mocks::{ICallReceiverDispatcher, ICallReceiverDispatcherTrait};
use crate::test_sol_account::PK1;

// ─── the locked vector ───
// Generated by `node packages/core/scripts/gen_snip9_vector.mjs` (no args — all
// default params; run `npm run -w @starkware-libs/anystark-core build` first).
// The generator HARD-FAILS unless:
//   (a) the TS-side SNIP-12 rev-1 hash of exactly this tuple (starknet.js
//       outsideExecution.getTypedData + typedData.getMessageHash) equals OZ's Cairo
//       get_message_hash:
//       0x6c5a129c256f83dc628cc23ba53f468a998c1f742bdd70c1edb6de970fee887
//       — so the fixture is TS<->Cairo cross-checked, never TS-only;
//   (b) the signer (Ed25519 seed bytes 0..31, the repo's locked test key)
//       re-derives LOCKED_PUBKEY.
// PK1 (imported from test_sol_account) is that key's pubkey as the little-endian
// u256 SolAccount stores. The hash also folds in the chain id ('SN_SEPOLIA',
// snforge's default), so the vector only holds under the default runner config.
// To re-derive the Cairo hash for a new tuple, run the `#[ignore]`d
// print_vector_snip12_hash test at the bottom of this file.
// The SNIP-12 hash binds the account address: the account MUST live exactly here.
const VECTOR_ACCOUNT: felt252 = 0x1234;
const VECTOR_TARGET: felt252 = 0x5678;
const VECTOR_CALLDATA: felt252 = 0xcafe;
const VECTOR_NONCE: felt252 = 1;
// Any address != VECTOR_ACCOUNT — the cross-account replay test deploys the same
// key here to prove the address-bound hash rejects it.
const OTHER_ACCOUNT: felt252 = 0x9abc;
// A SECOND locked vector, identical to the default one except caller is pinned to
// this specific relayer (folded into the SNIP-12 hash) and nonce is 2 (so it can
// run in the same account without colliding with the default vector's nonce 1).
// Proves OZ's caller-guard ACCEPTANCE branch: a matching submitter executes.
// Regenerate: `node packages/core/scripts/gen_snip9_vector.mjs caller=0x999
// nonce=0x2 expectedHash=<print_vector_snip12_hash for the pinned tuple>`.
const PINNED_CALLER: felt252 = 0x999;
const PINNED_CALLER_NONCE: felt252 = 2;
// The signed window is (0, 3600), STRICT on both ends; snforge's default now == 0
// falls OUTSIDE it, so every test moves the account's clock to this instant.
const IN_WINDOW_TS: u64 = 1000;

// The OutsideExecution struct field-for-field as signed. `calldata_value`
// parameterizes the single call's payload so the tamper test can change one byte
// while every other signed field stays identical.
fn vector_request(calldata_value: felt252) -> OutsideExecution {
    OutsideExecution {
        caller: 'ANY_CALLER'.try_into().unwrap(),
        nonce: VECTOR_NONCE,
        execute_after: 0,
        execute_before: 3600,
        calls: array![
            Call {
                to: VECTOR_TARGET.try_into().unwrap(),
                selector: selector!("transfer"),
                calldata: array![calldata_value].span(),
            },
        ]
            .span(),
    }
}

