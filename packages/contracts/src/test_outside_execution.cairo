// A locked vector whose single call targets the account's OWN execute_after_upgrade
// migration hook (to = the account at VECTOR_ACCOUNT, selector execute_after_upgrade,
// from_version 0). Caller ANY_CALLER, nonce VECTOR_NONCE, window (0, 3600); same locked
// key + @starkware-libs/anystark-core encoder as vector_signature(), msg_len 0x2c (44). It is the adversarial
// SNIP-9 analog of the multicall FORBIDDEN_CALL case: OZ's SRC9 runs this call via a raw
// call_contract_syscall that bypasses __execute__'s FORBIDDEN_CALL guard, with caller ==
// the account == self, so only the callee's migration_in_progress flag can stop it.
fn migration_hook_request() -> OutsideExecution {
    OutsideExecution {
        caller: 'ANY_CALLER'.try_into().unwrap(),
        nonce: VECTOR_NONCE,
        execute_after: 0,
        execute_before: 3600,
        calls: array![
            Call {
                to: VECTOR_ACCOUNT.try_into().unwrap(),
                selector: selector!("execute_after_upgrade"),
                calldata: array![0].span(),
            },
        ]
            .span(),
    }
}

