// The pinned-caller request: caller is PINNED_CALLER (not ANY_CALLER) and nonce is
// PINNED_CALLER_NONCE, so it activates OZ's caller-equality guard.
fn pinned_caller_request() -> OutsideExecution {
    OutsideExecution {
        caller: PINNED_CALLER.try_into().unwrap(),
        nonce: PINNED_CALLER_NONCE,
        execute_after: 0,
        execute_before: 3600,
        calls: array![
            Call {
                to: VECTOR_TARGET.try_into().unwrap(),
                selector: selector!("transfer"),
                calldata: array![VECTOR_CALLDATA].span(),
            },
        ]
            .span(),
    }
}

