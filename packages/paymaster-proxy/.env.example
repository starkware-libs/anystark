# Secret upstream paymaster API key. Injected server-side as the
# `x-paymaster-api-key` header. NEVER expose this to the frontend.
PAYMASTER_API_KEY=

# Upstream SNIP-29 paymaster endpoint. Provider-agnostic: use an AVNU hosted
# endpoint or any self-hosted SNIP-29 instance.
#   Sepolia: https://sepolia.paymaster.avnu.fi
#   Mainnet: https://starknet.paymaster.avnu.fi
PAYMASTER_UPSTREAM_URL=https://sepolia.paymaster.avnu.fi

# Durable rate-limit store (Upstash Redis REST API). REQUIRED in production when
# the policy configures `rateLimit` or `globalCap`: without it the proxy FAILS
# CLOSED (refuses to start / refuses to sponsor) unless you set
# `allowInMemoryStore: true` in the policy (local/single-instance only).
# Create a database at https://console.upstash.com and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sponsorship policy as a single-line JSON string. The proxy only sponsors what
# this policy explicitly allows, so a leaked frontend cannot drain your gas
# budget. The allowlist + forced sponsored fee mode are enforced on BOTH
# `paymaster_buildTransaction` AND `paymaster_executeTransaction`. All felt
# values (allowlist targets/selectors, class hashes) are validated at startup,
# so a malformed felt fails the deploy rather than every request. Shape:
#   allowedCalls:          [{ to, selectors? }]   selectors omitted => any selector on `to`
#   sponsoredClassHashes:  [classHash, ...]        deployable class hashes you sponsor
#   rateLimit (optional):  { maxPerAddress, windowSec }     per-account limit
#   globalCap (optional):  { maxPerWindow, windowSec }      total budget across ALL addresses
#   feeMode (optional):    { mode, gas_token? }             forced fee mode (default { mode: "sponsored" })
#   maxTip (optional):     number                           clamp client tip (default: strip tip entirely)
#   allowInMemoryStore:    boolean                          LOCAL/TEST ONLY: disables the fail-closed guard
#
# Example:
# PAYMASTER_POLICY={"allowedCalls":[{"to":"0x049d36570d4e46f48e99674bd3fcc84644ddd6b96f7c741b1562b82f9e004dc7","selectors":["0x0083afd3f4caedc6eebf44246fe54e38c95e3179a5ec9ea81740eca5b482d12e"]}],"sponsoredClassHashes":["0x07ec6a68af00a71582569f94ee3ec85eb530365a06b6b7cefbef8f2f8f6c2288"],"rateLimit":{"maxPerAddress":20,"windowSec":3600},"globalCap":{"maxPerWindow":5000,"windowSec":3600}}
PAYMASTER_POLICY=
