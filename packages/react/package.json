{
  "name": "@starkware-libs/anystark-react",
  "version": "0.1.7",
  "description": "React integration for @starkware-libs/anystark-core: a @starknet-react/core Connector that adds Phantom alongside native Starknet wallets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starkware-libs/anystark.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:e2e:sepolia": "vitest run src/sepolia.live.e2e.test.ts",
    "test:e2e:sepolia:public": "vitest run src/sepolia.public.e2e.test.ts",
    "test:e2e:mainnet:public": "vitest run src/mainnet.public.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:lazy": "node ../core/scripts/assert_lazy.mjs react"
  },
  "size-limit": [
    {
      "name": "@starkware-libs/anystark-react import cost (connector + @starkware-libs/anystark-core, which eagerly imports @noble/curves ed25519 to validate a pubkey before deriving its address; garaga excluded, kept lazy by check:lazy) [measured 13.7 kB, limit rounded up for headroom]",
      "path": "dist/index.js",
      "ignore": [
        "garaga"
      ],
      "limit": "15 kB"
    }
  ],
  "dependencies": {
    "@starkware-libs/anystark-core": "^0.1.7",
    "@starknet-io/types-js": "^0.7.10"
  },
  "peerDependencies": {
    "@starknet-react/core": "^5.0.3",
    "starknet": ">=8.5.2 <9"
  },
  "devDependencies": {
    "@starknet-react/core": "5.0.3",
    "starknet": "8.9.2"
  }
}
